{
  "name": "homepanel-kiosk",
  "version": "0.0.1",
  "private": true,
  "description": "A lightweight Home Assistant display kiosk for Linux and Raspberry Pi",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --dev",
    "test": "node --test",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:linux": "electron-forge make --platform linux",
    "release": "electron-forge publish"
  },
  "dependencies": {
    "mqtt": "5.16.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/publisher-github": "8.0.1",
    "@electron/fuses": "2.1.3",
    "electron": "44.9.0"
  }
}
